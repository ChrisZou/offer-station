{
  "name": "job-workbench",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:typst": "node scripts/typst-compiler.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:studio": "npm --prefix apps/resume-studio run dev:workbench",
    "build:web": "npm --prefix apps/web run build",
    "build:studio": "npm --prefix apps/resume-studio run build:workbench",
    "build": "npm run build:studio && npm run build:web"
  }
}
